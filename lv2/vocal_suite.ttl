@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix time: <http://lv2plug.in/ns/ext/time#> .
@prefix pg:   <http://lv2plug.in/ns/ext/port-groups#> .
@prefix idpy: <http://harrisonconsoles.com/lv2/inlinedisplay#> .

idpy:interface a lv2:ExtensionData .
idpy:queue_draw a lv2:Feature .

# ---- plugin ----
@prefix vocal: <https://github.com/tylorismusic-commits/vocal-suite> .

<https://github.com/tylorismusic-commits/vocal-suite> a lv2:Plugin ;
  doap:name "Vocal Suite" ;
  doap:license <https://spdx.org/licenses/GPL-3.0-or-later.html> ;
  doap:maintainer [ foaf:name "tylorismusic" ] ;
  lv2:optionalFeature lv2:hardRTCapable , idpy:queue_draw ;
  lv2:extensionData idpy:interface ;
  lv2:port
    <#audio_in_l> , <#audio_in_r> , <#audio_out_l> , <#audio_out_r> ,
    <#power> ,
    <#input> ,
    <#polarity> ,
    <#hpf_on> ,
    <#hpf_freq> ,
    <#comp_on> ,
    <#comp_mode> ,
    <#comp_amount> ,
    <#comp_speed> ,
    <#comp_ratio> ,
    <#comp_mix> ,
    <#comp_auto> ,
    <#tone_on> ,
    <#low_gain> ,
    <#low_freq> ,
    <#low_bell> ,
    <#mid_gain> ,
    <#mid_freq> ,
    <#mid_q> ,
    <#high_gain> ,
    <#high_freq> ,
    <#high_bell> ,
    <#air> ,
    <#drive_on> ,
    <#drive_model> ,
    <#drive_amount> ,
    <#drive_char> ,
    <#drive_mix> ,
    <#deess_on> ,
    <#sib_freq> ,
    <#sib_amount> ,
    <#harsh_freq> ,
    <#harsh_amount> ,
    <#echo_on> ,
    <#echo_sync> ,
    <#echo_div> ,
    <#echo_time> ,
    <#echo_feedback> ,
    <#echo_tone> ,
    <#echo_width> ,
    <#echo_mod> ,
    <#echo_duck> ,
    <#echo_lofi> ,
    <#echo_mix> ,
    <#tempo> ,
    <#space_on> ,
    <#space_mode> ,
    <#space_size> ,
    <#space_decay> ,
    <#space_predelay> ,
    <#space_tone> ,
    <#space_width> ,
    <#space_duck> ,
    <#space_mix> ,
    <#output> ,
    <#limit_on> ,
    <#limit_ceiling> ;
  lv2:port
    <#learn_input> , <#learn_sib> , <#compare> ,
    <#comp_gr> , <#sib_gr> , <#harsh_gr> , <#lim_gr> ,
    <#in_l> , <#in_r> , <#out_l> , <#out_r> ,
    <#input_learn_peak> , <#sib_learn_hz> , <#sib_learn_valid> ,
    <#host_bpm> , <#host_tempo> , <#latency> , <#time> ;
  ui:ui <#ui> .

<#ui> a ui:X11UI ;
  ui:binary <vocal_suite_ui.so> ;
  lv2:optionalFeature ui:resize ;
  lv2:requiredFeature ui:idleInterface ;
  lv2:extensionData ui:idleInterface .

<#audio_in_l> a lv2:AudioPort, lv2:InputPort ;
  lv2:index 0 ; lv2:symbol "audio_in_l" ; lv2:name "Audio In L" .

<#audio_in_r> a lv2:AudioPort, lv2:InputPort ;
  lv2:index 1 ; lv2:symbol "audio_in_r" ; lv2:name "Audio In R" .

<#audio_out_l> a lv2:AudioPort, lv2:OutputPort ;
  lv2:index 2 ; lv2:symbol "audio_out_l" ; lv2:name "Audio Out L" .

<#audio_out_r> a lv2:AudioPort, lv2:OutputPort ;
  lv2:index 3 ; lv2:symbol "audio_out_r" ; lv2:name "Audio Out R" .

<#power> a lv2:InputPort, lv2:ControlPort ;
  lv2:index 4 ;
  lv2:symbol "power" ;
  lv2:name "Power" ;
  lv2:default 1 ;
  lv2:minimum 0 ;
  lv2:maximum 1 ;
  lv2:portProperty lv2:integer ;
  lv2:portProperty lv2:toggled ;
  rdfs:comment "Recommended 0 to 1" .

<#input> a lv2:InputPort, lv2:ControlPort ;
  lv2:index 5 ;
  lv2:symbol "input" ;
  lv2:name "Input" ;
  lv2:default 0 ;
  lv2:minimum -18 ;
  lv2:maximum 18 ;
  units:unit units:db ;
  rdfs:comment "Recommended -6 to 6" .

<#polarity> a lv2:InputPort, lv2:ControlPort ;
  lv2:index 6 ;
  lv2:symbol "polarity" ;
  lv2:name "Polarity" ;
  lv2:default 0 ;
  lv2:minimum 0 ;
  lv2:maximum 1 ;
  lv2:portProperty lv2:integer ;
  lv2:portProperty lv2:toggled ;
  rdfs:comment "Recommended 0 to 1" .

<#hpf_on> a lv2:InputPort, lv2:ControlPort ;
  lv2:index 7 ;
  lv2:symbol "hpf_on" ;
  lv2:name "HPF On" ;
  lv2:default 1 ;
  lv2:minimum 0 ;
  lv2:maximum 1 ;
  lv2:portProperty lv2:integer ;
  lv2:portProperty lv2:toggled ;
  rdfs:comment "Recommended 0 to 1" .

<#hpf_freq> a lv2:InputPort, lv2:ControlPort ;
  lv2:index 8 ;
  lv2:symbol "hpf_freq" ;
  lv2:name "HPF" ;
  lv2:default 90 ;
  lv2:minimum 20 ;
  lv2:maximum 350 ;
  units:unit units:hz ;
  rdfs:comment "Recommended 70 to 120" .

<#comp_on> a lv2:InputPort, lv2:ControlPort ;
  lv2:index 9 ;
  lv2:symbol "comp_on" ;
  lv2:name "Comp On" ;
  lv2:default 1 ;
  lv2:minimum 0 ;
  lv2:maximum 1 ;
  lv2:portProperty lv2:integer ;
  lv2:portProperty lv2:toggled ;
  rdfs:comment "Recommended 0 to 1" .

<#comp_mode> a lv2:InputPort, lv2:ControlPort ;
  lv2:index 10 ;
  lv2:symbol "comp_mode" ;
  lv2:name "Mode" ;
  lv2:default 0 ;
  lv2:minimum 0 ;
  lv2:maximum 2 ;
  lv2:portProperty lv2:integer ;
  lv2:scalePoint [ rdfs:label "Opto" ; rdf:value 0 ] ;
  lv2:scalePoint [ rdfs:label "FET" ; rdf:value 1 ] ;
  lv2:scalePoint [ rdfs:label "VCA" ; rdf:value 2 ] ;
  rdfs:comment "Recommended 0 to 2" .

<#comp_amount> a lv2:InputPort, lv2:ControlPort ;
  lv2:index 11 ;
  lv2:symbol "comp_amount" ;
  lv2:name "Comp" ;
  lv2:default 3 ;
  lv2:minimum 0 ;
  lv2:maximum 10 ;
  rdfs:comment "Recommended 3 to 7" .

<#comp_speed> a lv2:InputPort, lv2:ControlPort ;
  lv2:index 12 ;
  lv2:symbol "comp_speed" ;
  lv2:name "Speed" ;
  lv2:default 5 ;
  lv2:minimum 0 ;
  lv2:maximum 10 ;
  rdfs:comment "Recommended 3 to 7" .

<#comp_ratio> a lv2:InputPort, lv2:ControlPort ;
  lv2:index 13 ;
  lv2:symbol "comp_ratio" ;
  lv2:name "Ratio" ;
  lv2:default 0 ;
  lv2:minimum 0 ;
  lv2:maximum 2 ;
  lv2:portProperty lv2:integer ;
  lv2:scalePoint [ rdfs:label "4:1" ; rdf:value 0 ] ;
  lv2:scalePoint [ rdfs:label "8:1" ; rdf:value 1 ] ;
  lv2:scalePoint [ rdfs:label "20:1" ; rdf:value 2 ] ;
  rdfs:comment "Recommended 0 to 2" .

<#comp_mix> a lv2:InputPort, lv2:ControlPort ;
  lv2:index 14 ;
  lv2:symbol "comp_mix" ;
  lv2:name "Mix" ;
  lv2:default 100 ;
  lv2:minimum 0 ;
  lv2:maximum 100 ;
  units:unit units:pc ;
  rdfs:comment "Recommended 60 to 100" .

<#comp_auto> a lv2:InputPort, lv2:ControlPort ;
  lv2:index 15 ;
  lv2:symbol "comp_auto" ;
  lv2:name "Auto Makeup" ;
  lv2:default 1 ;
  lv2:minimum 0 ;
  lv2:maximum 1 ;
  lv2:portProperty lv2:integer ;
  lv2:portProperty lv2:toggled ;
  rdfs:comment "Recommended 0 to 1" .

<#tone_on> a lv2:InputPort, lv2:ControlPort ;
  lv2:index 16 ;
  lv2:symbol "tone_on" ;
